<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Product template aanpassing in Sales/Product view -->
    <record id="view_product_template_form_inherit_pico" model="ir.ui.view">
        <field name="name">product.template.form.inherit.pico</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='barcode']" position="after">
                <field name="pieces_per_pallet" string="Aantal stuks per pallet"/>
            </xpath>
        </field>
    </record>

    <!-- Product variant view aanpassing (voorraad / magazijn klik) -->
    <record id="view_product_product_form_inherit_pico" model="ir.ui.view">
        <field name="name">product.product.form.inherit.pico</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='barcode']" position="after">
                <field name="pieces_per_pallet" string="Aantal stuks per pallet"/>
            </xpath>
        </field>
    </record>

</odoo>
