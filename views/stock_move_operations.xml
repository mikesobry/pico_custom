<odoo>

    <record id="view_stock_move_line_operation_tree_pico" model="ir.ui.view">
        <field name="name">stock.move.line.operation.tree.pico</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='quantity']" position="before">
                <field name="pallets_loaded"/>
            </xpath>

            <xpath expr="//field[@name='pallets_loaded']" position="after">
                <field name="pico_batch_code"/>
            </xpath>

            <!--
            <xpath expr="//field[@name='pallets_loaded']" position="before">
                <field name="id"/>
            </xpath>
            -->

            <xpath expr="//field[@name='quantity']" position="after">
                <field name="line_weight"/>
            </xpath>

        </field>

    </record>

    <record id="view_stock_move_operations_pico" model="ir.ui.view">
        <field name="name">stock.move.operations.form.pico</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_stock_move_operations"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='move_line_ids']" position="attributes">
                <attribute name="context">
                    {
                        'list_view_ref': 'pico_custom.view_stock_move_line_operation_tree_pico',
                        'form_view_ref': 'stock.view_move_line_mobile_form',
                        'default_picking_id': picking_id,
                        'default_move_id': id,
                        'default_product_id': product_id,
                        'default_location_id': location_id,
                        'default_location_dest_id': location_dest_id,
                        'default_company_id': company_id,
                        'active_picking_id': picking_id
                    }
                </attribute>
            </xpath>

        </field>
</record>

</odoo>