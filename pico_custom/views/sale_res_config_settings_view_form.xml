<odoo>
    <record id="view_res_config_settings_inherit_pico" model="ir.ui.view">
        <field name="name">res.config.settings.inherit.pico</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <!-- Injecteer in Sales block -->
            <xpath expr="//block[@name='catalog_setting_container']" position="after">
                <block title="Custom settings for sales" name="my_custom_setting_block">
                    <setting id="my_custom_setting" string="Standaard levertermijn in dagen">
                        <field name="sale_preparation_days"/>
                    </setting>
                </block>
            </xpath>

        </field>
    </record>
</odoo>

