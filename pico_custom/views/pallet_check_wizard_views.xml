<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_pico_pallet_check_wizard_form" model="ir.ui.view">
        <field name="name">pico.pallet.check.wizard.form</field>
        <field name="model">pico.pallet.check.wizard</field>
        <field name="arch" type="xml">
            <form string="Pallets controleren">
                <div class="alert alert-warning" role="alert">
                    <strong>Attention : palettes non conformes.</strong>
                </div>
                <field name="message" readonly="1" nolabel="1"/>
                <p class="mt-3">Continuer quand même ?</p>
                <footer>
                    <button string="Valider quand même" name="action_confirm"
                            type="object" class="btn-secondary"/>
                    <button string="Annuler" special="cancel" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>