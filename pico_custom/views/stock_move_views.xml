<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_picking_form_inherit_pico" model="ir.ui.view">
        <field name="name">stock.picking.form.inline.list.inherit.pico</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_ids']/list/field[@name='product_uom_qty']" position="before">
                <field name="requested_pallets"/>
            </xpath>
            <xpath expr="//field[@name='move_ids']/list/field[@name='product_uom_qty']" position="after">
                <field  name="loaded_pallets"
                        string="Pallets"
                        attrs="{'readonly':[('move_line_count','>',1)]}"/>
            </xpath>
            <xpath expr="//field[@name='move_ids']/list/field[@name='loaded_pallets']" position="after">
                <field  name="pico_batch_code"
                        attrs="{'readonly':[('move_line_count','>',1)]}"/>
            </xpath>

            <xpath expr="//field[@name='move_ids']/list/field[@name='quantity']" position="after">
                <field name="line_weight"/>
            </xpath>
        </field>
    </record>
</odoo>
