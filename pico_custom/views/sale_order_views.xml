<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- standaard vieuw voor Offerte / Sales order aanpassen
            - ref klant in hoofdvieuw plaatsen
            - totaal gewicht van order onderaan toevoegen
     -->
    <record id="view_sale_order_form_inherit_pico" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.pico</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- 1. Verplaats veld client_order_ref naar hoofdpagina -->
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="client_order_ref"/>
                <field name="commitment_date"/>
            </xpath>
            <!-- 2. Verberg veld client_order_ref in tab ander info -->
	        <xpath expr="//page[@name='other_information']//field[@name='client_order_ref']" position="attributes">
               <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='tax_totals']" position="after">
                <div class="mt-2">

                    <div class="d-flex align-items-baseline">
                        <strong class="me-2 text-nowrap">Netto gewicht (kg):</strong>
                        <field name="total_weight" readonly="1" nolabel="1"/>
                    </div>

                    <div class="d-flex align-items-baseline">
                        <strong class="me-2 text-nowrap">Bruto gewicht (kg):</strong>
                        <field name="total_gross_weight" readonly="1" nolabel="1"/>
                    </div>

                    <div class="d-flex align-items-baseline">
                        <strong class="me-2 text-nowrap">Totaal aantal pallets:</strong>
                        <field name="total_pallets" readonly="1" nolabel="1" widget="integer"/>
                    </div>

                </div>
            </xpath>


        </field>
    </record>

    <!-- standaard vieuw voor Offerte / Sales order - kolom voor pallet en gewicht toevoegen -->
    <record id="view_sale_order_form_inline_list_inherit_pico" model="ir.ui.view">
        <field name="name">sale.order.form.inline.list.inherit.pico</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="before">
                <field name="pallet_qty" string="Pallets"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="after">
                <field name="line_weight" string="Gewicht (kg)" readonly="1"/>
            </xpath>
        </field>
    </record>

    <!-- Draft/Editable weergave
    <record id="view_order_line_tree_inherit_pico" model="ir.ui.view">
        <field name="name">sale.order.line.tree.inherit.pico</field>
        <field name="model">sale.order.line</field>
        <field name="inherit_id" ref="sale.view_order_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_uom_qty']" position="before">
                <field name="pallet_qty"/>
            </xpath>
        </field>
    </record>
    -->

    <!-- Readonly Sales Order Line weergave - aantal pallets toevoegen
         Wordt eigenlijk niet gebruikt, enkel zichtbaar in debugmode via bekijk knop-->
    <record id="view_order_line_form_readonly_inherit_pico" model="ir.ui.view">
        <field name="name">sale.order.line.form.readonly.inherit.pico</field>
        <field name="model">sale.order.line</field>
        <field name="inherit_id" ref="sale.sale_order_line_view_form_readonly"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_uom_qty']" position="after">
                <field name="pallet_qty"/>
            </xpath>
        </field>
    </record>

</odoo>
