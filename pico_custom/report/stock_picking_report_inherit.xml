<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_deliveryslip_pico_inherit"
              inherit_id="stock.report_delivery_document"
              name="Pico leveringsbon: pallets, gewicht, totalen">

        <!-- Altijd per-lijn weergave (met lotkolom), ongeacht groep of aanwezige lots -->
        <xpath expr="//table[@name='stock_move_line_table']/thead" position="before">
            <t t-set="has_serial_number" t-value="True"/>
        </xpath>

        <!-- Kolomhoofden -->
        <xpath expr="//th[@name='th_sml_product']" position="before">
            <th name="th_sml_pallets" class="text-end">Pallets</th>
        </xpath>
        <xpath expr="//th[@name='th_sml_quantity']" position="after">
            <th name="th_sml_weight" class="text-end">Weight</th>
        </xpath>

        <!-- Totalen onder de tabel -->
        <xpath expr="//table[@name='stock_move_line_table']" position="after">
            <div t-if="o.state == 'done'" name="pico_totals" class="row mt-3">
                <div class="col-8" t-if="o.picking_type_code == 'outgoing'">
                    <table class="table table-sm table-borderless" style="width:auto;">
                        <tr>
                            <td><strong>Pallets uit</strong></td>
                            <td class="text-end"><span t-out="o.pallets_loaded"/></td>
                        </tr>
                        <tr>
                            <td><strong>Pallets retour</strong></td>
                            <td class="text-end"><span t-out="o.pallets_received"/></td>
                        </tr>
                        <tr>
                            <td><strong>Pallet saldo</strong></td>
                            <td class="text-end"><span t-out="o.pallet_balance"/></td>
                        </tr>
                    </table>
                </div>
                <div class="col-4" t-if="o.picking_type_code == 'outgoing'">
                    <table class="table table-sm table-borderless" style="width:auto; margin-left:auto;">
                        <tr>
                            <td class="text-nowrap"><strong>Net weight</strong></td>
                            <td class="text-end text-nowrap"><span t-field="o.total_net_weight"/> kg</td>
                        </tr>
                        <tr>
                            <td class="text-nowrap"><strong>Gross weight</strong></td>
                            <td class="text-end text-nowrap"><span t-field="o.total_gross_weight"/> kg</td>
                        </tr>
                    </table>
                </div>
            </div>
        </xpath>
    </template>

    <!-- Per-lijn rij: pallets vooraan, gewicht achteraan -->
    <template id="stock_report_delivery_has_serial_move_line_pico"
              inherit_id="stock.stock_report_delivery_has_serial_move_line"
              name="Pico leveringsbon rij">

        <xpath expr="//td[1]" position="before">
            <td class="text-end"><span t-out="int(move_line.pallets_loaded or 0)"/></td>
        </xpath>

        <!-- Overgangsfase: val terug op het oude pico-lot zolang oude data niet gemigreerd is -->
        <xpath expr="//span[@t-field='move_line.lot_id.name']" position="replace">
            <span t-out="move_line.lot_id.name or move_line.pico_batch_code"/>
        </xpath>

        <xpath expr="//td[@name='move_line_lot_quantity']" position="after">
            <td class="text-end"><span t-field="move_line.line_weight"/> kg</td>
        </xpath>
    </template>
</odoo>